<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- El atributo stylesheets conecta el CSS (ruta relativa a este FXML) -->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.torneo.controller.TorneoController"
            stylesheets="@../css/minecraft.css"
            styleClass="ventana">

    <!-- ============ CABECERA (césped sobre tierra) ============ -->
    <top>
        <VBox styleClass="header" alignment="CENTER_LEFT" spacing="2">
            <padding><Insets top="18" right="24" bottom="16" left="24"/></padding>
            <Label text="TORNEO MINECRAFT" styleClass="titulo"/>
            <Label text="Sistema de inscripción de jugadores" styleClass="subtitulo"/>
        </VBox>
    </top>

    <!-- ============ FORMULARIO ============ -->
    <left>
        <VBox styleClass="panel" spacing="10" prefWidth="320" minWidth="300">
            <BorderPane.margin><Insets top="16" right="8" bottom="16" left="16"/></BorderPane.margin>
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <Label text="INSCRIPCIÓN" styleClass="panel-titulo"/>
            <Label fx:id="lblModo" text="MODO: NUEVA INSCRIPCIÓN"
                   styleClass="modo,modo-nuevo" maxWidth="Infinity"/>

            <Label text="Nombre del jugador" styleClass="campo-label"/>
            <TextField fx:id="txtNombre" promptText="Ej: Steve" />

            <Label text="Correo electrónico" styleClass="campo-label"/>
            <TextField fx:id="txtCorreo" promptText="Ej: steve@minecraft.net" />

            <Region prefHeight="6"/>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Button fx:id="btnEnviar" text="ENVIAR" onAction="#onEnviar"
                        styleClass="btn-enviar" maxWidth="Infinity"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="btnActualizar" text="ACTUALIZAR" onAction="#onActualizar"
                        styleClass="btn-actualizar" maxWidth="Infinity"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="btnRecordar" text="RECORDAR" onAction="#onRecordar"
                        styleClass="btn-recordar" maxWidth="Infinity"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="btnEliminar" text="ELIMINAR" onAction="#onEliminar"
                        styleClass="btn-eliminar" maxWidth="Infinity"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button fx:id="btnLimpiar" text="LIMPIAR FORMULARIO" onAction="#onLimpiar"
                        styleClass="btn-limpiar" maxWidth="Infinity"
                        GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="ayuda-box" spacing="3">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <Label text="ATAJOS" styleClass="ayuda-titulo"/>
                <Label text="ENTER  Enviar / Actualizar" styleClass="ayuda"/>
                <Label text="ESC    Limpiar formulario" styleClass="ayuda"/>
                <Label text="2xCLIC Recordar fila" styleClass="ayuda"/>
                <Label text="SUPR   Eliminar fila" styleClass="ayuda"/>
            </VBox>
        </VBox>
    </left>

    <!-- ============ TABLA ============ -->
    <center>
        <VBox styleClass="panel" spacing="10">
            <BorderPane.margin><Insets top="16" right="16" bottom="16" left="8"/></BorderPane.margin>
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="JUGADORES INSCRITOS" styleClass="panel-titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar..." prefWidth="220" styleClass="buscador"/>
            </HBox>

            <TableView fx:id="tablaJugadores" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70" minWidth="60" maxWidth="90"/>
                    <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="220"/>
                    <TableColumn fx:id="colCorreo" text="CORREO" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ============ BARRA DE ESTADO ============ -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <Label fx:id="lblEstado" text="" styleClass="estado-ok"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblContador" text="JUGADORES: 0" styleClass="contador"/>
        </HBox>
    </bottom>
</BorderPane>
